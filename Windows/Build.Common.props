<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <IntDir>$(MSBuildThisFileDirectory)out\$(Platform)\obj\$(MSBuildProjectName)\</IntDir>
    <BGJsonInclude>$(MSBuildThisFileDirectory)out\deps\nlohmann_json\include</BGJsonInclude>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
      <ExceptionHandling>Sync</ExceptionHandling>
      <ConformanceMode>true</ConformanceMode>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <AdditionalIncludeDirectories>$(BGJsonInclude);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalOptions>/utf-8 /bigobj %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>UNICODE;_UNICODE;NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>bcrypt.lib;winsqlite3.lib;Normaliz.lib;setupapi.lib;cfgmgr32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="$(MSBuildThisFileDirectory)Core\NativeFiles.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)Core\Store.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)Core\RestorePoints.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)Core\DiskDiagnostics.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)Core\Watch.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)Core\Engine.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)Core\BackupSet.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)Core\Coordinator.cpp" />
  </ItemGroup>
</Project>
